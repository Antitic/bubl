{
  "name": "bubl",
  "version": "1.0.0",
  "description": "Bubl — a modern, privacy-respecting portable web browser built on Electron",
  "author": "Bubl",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack:dir": "electron-builder --dir",
    "build:portable": "electron-builder --win portable",
    "build": "electron-builder --win portable dir"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.5.1",
    "@ghostery/adblocker-electron": "^2.5.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bubl.browser",
    "productName": "Bubl",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/resources/tor/**/*",
      "src/main/resources/ublock/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "icon": "assets/icon.png",
      "artifactName": "Bubl-Portable-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Bubl-Portable-${version}.${ext}",
      "unpackDirName": "Bubl"
    }
  }
}
